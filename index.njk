  <section id="board">
    <div class="wrap">
      <div class="board-head">
        <h2>Projects</h2>
      </div>
      <div class="board-grid">
        {%- for p in projects %}
        <div class="pin-card hide">
          <h3>
            {%- if p.url %}<a href="{{ p.url }}" >{{ p.title }}</a>{% else %}{{ p.title }}{% endif -%}
          </h3>
          <p>{{ p.description }}</p>
          <span class="stack">{{ p.stack }}</span>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section id="cold">
    <div class="wrap">
      <h2>Articles</h2>
      <p class="lead">Every write-up is filed by topic. Pull a drawer to see what's inside</p>
      <div class="cabinet" id="cabinet">
        {%- for key, t in drawers %}
        {%- set ps = collections.post | byTag(key) %}
        <section class="drawer" id="d-{{ key }}">
          <button class="front" aria-expanded="false" aria-controls="p-{{ key }}">
            <span class="plate">{{ t.name }}<small>{{ t.note }}</small></span>
            <span class="files hand">{{ ps.length }} {{ "file" if ps.length == 1 else "files" }}</span>
            <span class="handle"></span>
          </button>
          <div class="panel" id="p-{{ key }}">
            <div>
              <div class="inside">
                {%- for p in ps %}
                <a class="folder" style="--i:{{ loop.index0 }}" data-date="{{ p.date | fmtDate }}" href="{{ p.url }}"><span class="clipx"></span><h3>{{ p.data.title }}</h3><p>{{ p.data.summary }}</p><span class="fstamp">OPEN FILE</span></a>
                {%- else %}
                <p class="empty hand">Empty drawer. Nothing filed yet.</p>
                {%- endfor %}
              </div>
            </div>
          </div>
        </section>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <h2>Contact</h2>
      <p class="lead" style="max-width:100%">If you want to contact me to ask questions or network, here are my email
        and LinkedIn:</p>
      <ul>
        <li>Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li>LinkedIn: <a href="{{ site.linkedin }}" target="_blank" rel="noopener">{{ site.linkedinLabel }}</a></li>
      </ul>
      <p class="lead" style="max-width:100%">Here is also my CV (written in French) in case you want to know more about
        my background and skills:</p>
      <ul>
        <li>CV: <a href="{{ site.cv }}" target="_blank" rel="noopener noreferrer">Download my CV (PDF)</a></li>
      </ul>
    </div>
  </section>
